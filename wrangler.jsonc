{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "royos",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "observability": { "enabled": true },
  // The page's CSS, markup and browser script live in web/ as plain files and are imported as text.
  "rules": [{ "type": "Text", "globs": ["**/*.css", "**/*.html", "**/*.client.js"], "fallthrough": false }],
  // Roy OS keeps its own state (weekly worlds, the day's ticks, moods, plan) in a SQLite Durable Object;
  // the quest D1 is read only here, its schema belongs to quest-engine.
  "durable_objects": { "bindings": [{ "name": "STATE", "class_name": "DeskState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeskState"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "quest", "database_id": "94e5f5c7-b24f-4a3c-808c-a85345a27f7f" }],
  // Workers on one account cannot fetch each other's workers.dev URL, so the quest engine is reached over a service binding.
  // Commute days set on Roy OS are saved through the admin dashboard's POST /border/save (it owns work_location's writes).
  // The boss widget's popup serves the boss card and the Goku card (their own Workers, behind Access) through bindings too.
  "services": [{ "binding": "QUEST_ENGINE", "service": "quest-engine" }, { "binding": "BOSS_CARD", "service": "boss" }, { "binding": "GOKU_CARD", "service": "mainquest" }, { "binding": "ADMIN_BOARD", "service": "admindashboard" }],
  "workflows": [{ "name": "royos-theme", "binding": "DESK_THEME", "class_name": "DeskTheme" }],
  // Every hour: makes the week's world on Monday from 06:00 Amsterdam, and catches up if that failed.
  "triggers": { "crons": ["5 * * * *"] },
  "vars": {
    "QUEST_ENGINE_URL": "https://quest-engine.quest-engine.workers.dev",
    "IMAGE_MODEL": "gpt-image-2.5-flare",
    "VIDEO_MODEL": "gemini-omni-flash-preview",
    "CHAT_MODEL": "gpt-6-astra",
    "WEATHER_LAT": "51.286",
    "WEATHER_LON": "3.828",
    "WEATHER_PLACE": "Terneuzen",
    // A one-off remake the hourly cron runs: "<week>|<character>|<ISO time>" (see remakeDue in src/themes.js).
    "REMAKE": "2026-W41|Jinx|2026-10-06T07:00:00Z",
    // A week's critter outside the Monday run, made once per ask: "<week>|<ISO time>", or
    // "<week>|<sheet>|<ISO time>" to repaint one sheet (see critterDue in src/themes.js).
    "CRITTER_ART": "2026-W41|rest|2026-10-06T08:30:00Z"
  }
  // Secrets (npx wrangler secret put <NAME>):
  //   DESK_PASSWORD           the screen's login (one cookie, 30 days)
  //   ADMIN_TOKEN             X-Admin-Token for the maintenance routes (/theme/run, /theme/list)
  //   QUEST_ENGINE_TOKEN      the quest engine's ADMIN_TOKEN, for its /recovery route
  //   GEMINI_API_KEY          Nano Banana 2 stills and Veo clips
  //   CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET   cloud a3xk0plk, folder Desk-Themes
  //   OPENAI_API_KEY          Ask Claude box (chat model above)
  //   ADMIN_PASSWORD          the admin dashboard's DASHBOARD_PASSWORD, to save commute days there (src/work.js)
  // FAMILY_ICS_URL (the published iCloud link of the family calendar, webcal:// or https://), STEPH_ICS_URL (Steph's work calendar, her lane only), ROY_ICS_URL (Roy's personal calendar, his lane and Coming up), KIDS_ICS_URL (the kids' calendar, their lane and Coming up; optional), LANE_WORDS ("roy:roy;steph:steph,stephanie;kids:<names>,kindjes": title words that put a calendar event on a lane)
}
